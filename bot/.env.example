CARDAPIO_URL=https://arcelino-cavalcante.github.io/novo-cardapio-git-cms/

# PIX: preencha antes de iniciar o bot.
PIX_KEY=COLOQUE_A_CHAVE_PIX
PIX_HOLDER=COLOQUE_O_NOME_DO_TITULAR
PIX_CITY=Garanhuns

# Impressora térmica de rede (ESC/POS).
PRINTER_IP=192.168.3.14
PRINTER_PORT=9100
PRINT_ENABLED=true
PRINTER_CHARS_PER_LINE=40

# Números autorizados a executar "admin: valor" e "admin: imp".
# Use DDI + DDD + número, separados por vírgula.
ADMIN_NUMBERS=5587999999999

# Opcional. Se vazio, o bot procura o Chrome no caminho padrão do sistema.
CHROME_PATH=
HEADLESS=false
WHATSAPP_CLIENT_ID=la-mundo

DB_PATH=./leonus.db
TIMEZONE=America/Recife
STORE_NAME=LA MUNDO DOS SABORES
TICKET_FOOTER=É hoje que eu como mais uma fatia!

# Painel operacional local aberto junto com o bot.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3030
DASHBOARD_AUTO_OPEN=true
